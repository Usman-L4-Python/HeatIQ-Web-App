{
  "version": 2,
  "builds": [
    { "src": "app.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/users/(.*)",   "dest": "/app.js" },
    { "src": "/weather/(.*)", "dest": "/app.js" },
    { "src": "/reports/(.*)", "dest": "/app.js" },
    { "src": "/admin/(.*)",   "dest": "/app.js" },
    { "src": "/users",   "dest": "/app.js" },
    { "src": "/weather", "dest": "/app.js" },
    { "src": "/reports", "dest": "/app.js" },
    { "src": "/admin",   "dest": "/app.js" },
    { "src": "/",                   "dest": "/public/index.html" },
    { "src": "/(.*\\.(html|css|js|png|jpg|jpeg|gif|svg|ico|webp|json))", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/public/$1.html" }
  ]
}